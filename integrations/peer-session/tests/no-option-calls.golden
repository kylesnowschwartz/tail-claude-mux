== attach-match 0
["list-sessions", "-F", "#{session_path}\t#{session_name}"]
["new-window", "-d", "-P", "-F", "#{pane_id}", "-t", "=work:", "-n", "claude", "-c", "TMP"]
["send-keys", "-t", "%128", "peer_task=\"$(cat -- 'TMP/prompt')\" && [ -n \"$peer_task\" ] && claude --permission-mode auto -- \"$peer_task\"", "Enter"]
["capture-pane", "-p", "-t", "%128"]
curl
